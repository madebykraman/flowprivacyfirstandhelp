# Ritmi optional public-layer / remote-backup deployment template
NODE_ENV=production
PORT=8787
NIJRITU_STORE_FILE=./.ritmi-data/store.json
NIJRITU_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_SECRET
NIJRITU_CORS_ORIGIN=https://REPLACE_WITH_REAL_RITMI_ORIGIN

# IMPORTANT:
# This example is not a production credential set.
# The included JSON adapter is staging/local only. Production requires
# durable shared storage, backups, retention/deletion controls, monitoring,
# durable rate limiting and an operational moderation process.
